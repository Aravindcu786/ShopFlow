<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutNoInternetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:clickable="true"
    android:focusable="true"
    android:elevation="60dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Small Image for No Internet -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_no_internet_badge">

            <ImageView
                android:id="@+id/ivNoInternet"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/no_internet_title"
                android:src="@drawable/ic_no_internet"
                app:tint="@color/error" />
        </FrameLayout>

        <!-- No Internet Title -->
        <TextView
            android:id="@+id/tvNoInternetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/no_internet_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- No Internet Description -->
        <TextView
            android:id="@+id/tvNoInternetMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/no_internet_message"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Retry Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNoInternetRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:minWidth="160dp"
            android:text="@string/btn_retry"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp" />

        <!-- Network Settings Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNoInternetSettings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/btn_network_settings"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
