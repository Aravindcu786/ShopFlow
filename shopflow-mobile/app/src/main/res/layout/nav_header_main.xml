<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_light"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Avatar -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_logo_badge">

        <TextView
            android:id="@+id/tvNavAvatarInitials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="JD"
            android:textColor="@color/primary"
            android:textSize="20sp" />
    </FrameLayout>

    <!-- Name -->
    <TextView
        android:id="@+id/tvNavCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        android:text="John Doe"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <!-- Customer ID -->
    <TextView
        android:id="@+id/tvNavCustomerId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Customer ID: CUST001"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Email -->
    <TextView
        android:id="@+id/tvNavCustomerEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="john.doe@example.com"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/input_stroke" />

</LinearLayout>
